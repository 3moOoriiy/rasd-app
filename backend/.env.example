# =============================================================
# Rasd App — environment variables
# =============================================================
# Copy this file to `.env` and fill in your own values.
# The .env file is gitignored — your cookies stay local.
#
# Without these, the app falls back to "highlights" mode which
# returns mostly old/random tweets per account. With them set,
# the app returns the real chronological timeline.
#
# How to get them:
#   1. Open x.com in your browser and sign in.
#   2. Press F12 → Application → Cookies → x.com
#   3. Copy the value of `auth_token` → X_AUTH_TOKEN below
#   4. Copy the value of `ct0`       → X_CT0 below
# =============================================================

X_AUTH_TOKEN=
X_CT0=
