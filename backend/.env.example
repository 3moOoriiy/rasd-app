# =============================================================
# Rasd App — environment variables
# =============================================================
# Copy this file to `.env` and fill in your own values.
# The .env file is gitignored — your secrets stay local.
# =============================================================

# ---------------------- X / Twitter ----------------------
# Without these the app falls back to a "highlights" mode which
# returns mostly old/random tweets. With them set, the app
# returns the real chronological timeline.
#
# How to get them:
#   1. Open x.com in your browser and sign in.
#   2. Press F12 → Application → Cookies → x.com
#   3. Copy `auth_token` → X_AUTH_TOKEN
#   4. Copy `ct0`        → X_CT0
X_AUTH_TOKEN=
X_CT0=

# ---------------------- Facebook (Selenium) ----------------------
# Facebook now blocks unauthenticated scraping. To fetch FB posts
# we drive a real Edge browser and log in once with a throwaway
# account. Recommended: create a *new* throwaway FB account just
# for this — don't use your personal one.
#
#   FB_EMAIL          — login email
#   FB_PASSWORD       — login password
#   EDGE_DRIVER_PATH  — path to msedgedriver.exe (download from
#                       https://developer.microsoft.com/microsoft-edge/tools/webdriver/)
#                       leave blank if msedgedriver is on PATH
#   FB_HEADLESS       — "1" (default) hides the browser; "0" shows
#                       it on screen, useful for debugging login.
FB_EMAIL=
FB_PASSWORD=
EDGE_DRIVER_PATH=
FB_HEADLESS=1
